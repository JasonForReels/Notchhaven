    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالتحكم في أحداث النظام لتوسيط نوافذ معاينة لقطات الشاشة والتسجيل تلقائياً على شاشة الشق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешете контрол над Системни събития за автоматично центриране на прозорците за предварителен преглед на екранни снимки и записи върху дисплея на ноча."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনশট এবং রেকর্ডিং প্রিভিউ উইন্ডো নচ ডিসপ্লেতে স্বয়ংক্রিয়ভাবে কেন্দ্রে রাখার জন্য সিস্টেম ইভেন্টগুলির নিয়ন্ত্রণের অনুমতি দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet el control dels esdeveniments del sistema per centrar automàticament les finestres de previsualització de captures i gravacions a la pantalla del notch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zobrazení médií ve výřezu je vyžadován přístup k mediálním datům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad kontrol over Systemhændelser for automatisk at centrere skærmbillede- og optagelsesforhåndsvisningsvinduer på notch-skærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir benötigen Zugriff auf Mediendaten zur Anzeige in der Notch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε τον έλεγχο των Συμβάντων Συστήματος για αυτόματο κεντράρισμα των παραθύρων προεπισκόπησης στιγμιότυπων οθόνης και εγγραφών στην οθόνη notch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need access to media data for display in Notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso a los datos multimedia para mostrarlos en la muesca."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازه کنترل رویدادهای سیستم را بدهید تا پنجره‌های پیش‌نمایش اسکرین‌شات و ضبط به‌طور خودکار در صفحه ناچ وسط‌چین شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli järjestelmätapahtumien hallinta kuvakaappausten ja tallenteiden esikatseluikkunoiden automaattiseen keskittämiseen notch-näytölle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahintulutan ang kontrol sa mga kaganapan ng system upang awtomatikong i-center ang mga window ng preview ng screenshot at recording sa display ng notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons besoin d'accéder aux données multimédias pour les afficher dans l'encoche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר שליטה באירועי מערכת כדי למרכז אוטומטית חלונות תצוגה מקדימה של צילומי מסך והקלטות בתצוגת המגרעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच डिस्प्ले पर स्क्रीनशॉट और रिकॉर्डिंग पूर्वावलोकन विंडो को स्वचालित रूप से केंद्रित करने के लिए सिस्टम इवेंट्स को नियंत्रित करने की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite kontrolu nad sistemskim događajima za automatsko centriranje prozora pretpregleda snimaka zaslona i snimanja na zaslonu ureza."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a Rendszeresemények vezérlését a képernyőképek és felvételek előnézeti ablakainak automatikus középre igazításához a notch kijelzőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan akses ke data media untuk menampilkannya di notch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario l'accesso ai dati multimediali per visualizzarli nel notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチにメディア再生情報を表示するためにメディアデータへのアクセスが必要です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скриншоттар мен жазбалардың алдын ала қарау терезелерін ойық дисплейінде автоматты түрде ортаға келтіру үшін жүйелік оқиғаларды басқаруға рұқсат беріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 미디어 재생 정보를 표시하려면 미디어 데이터 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan kawalan Acara Sistem untuk memusatkan tetingkap pratonton tangkapan skrin dan rakaman secara automatik pada paparan notch."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat kontroll over Systemhendelser for automatisk å sentrere forhåndsvisningsvinduer for skjermbilder og opptak på notch-skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot mediagegevens is vereist om deze in de notch weer te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagany jest dostęp do danych multimediów w celu ich wyświetlania w notchu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos de acesso aos dados de reprodução multimédia para os apresentar no notch."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți controlul evenimentelor de sistem pentru a centra automat ferestrele de previzualizare ale capturilor de ecran și înregistrărilor pe afișajul notch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется доступ к медиаданным для отображения в вырезе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte ovládanie systémových udalostí na automatické centrovanie okien náhľadov snímok obrazovky a záznamov na displeji výrezu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволите контролу над системским догађајима за аутоматско центрирање прозора прегледа снимака екрана и снимака на екрану ноча."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till mediedata krävs för att visa dem i flärpen (notch)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ควบคุม System Events เพื่อจัดหน้าต่างแสดงตัวอย่างภาพหน้าจอและการบันทึกให้อยู่ตรงกลางบนรอยบากโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentikte gösterebilmek için ortam verilerine erişim gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен доступ до медіаданих для їх відображення у вирізі (notch)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền truy cập dữ liệu phương tiện để hiển thị trên notch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要访问媒体数据，以便在刘海中显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要媒體資料存取權限才能在「瀏海」中顯示媒體內容。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Notchhaven للوصول إلى البلوتوث لعرض حالة البطارية والاتصال لملحقاتك اللاسلكية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven се нуждае от Bluetooth достъп, за да показва състоянието на батерията и връзката на вашите безжични аксесоари."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven-এর ওয়্যারলেস আনুষাঙ্গিকগুলির ব্যাটারি এবং সংযোগের স্থিতি প্রদর্শন করতে ব্লুটুথ অ্যাক্সেস প্রয়োজন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven necessita accés al Bluetooth per mostrar l'estat de la bateria i la connexió dels accessoris sense fil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace potřebuje přístup k Bluetooth pro kontrolu stavu zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven har brug for Bluetooth-adgang til at vise batteri- og forbindelsesstatus for dit trådløse tilbehør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App benötigt Bluetooth-Zugriff, um den Status von Geräten zu überprüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Notchhaven χρειάζεται πρόσβαση Bluetooth για να εμφανίζει την κατάσταση μπαταρίας και σύνδεσης για τα ασύρματα αξεσουάρ σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app requires Bluetooth access to check the status of devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación necesita acceso a Bluetooth para comprobar el estado de los dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven برای نمایش وضعیت باتری و اتصال لوازم جانبی بی‌سیم به دسترسی بلوتوث نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven tarvitsee Bluetooth-käyttöoikeuden näyttääkseen langattomien lisävarusteiden akun ja yhteyden tilan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng Notchhaven ng access sa Bluetooth upang ipakita ang baterya at katayuan ng koneksyon ng iyong mga wireless accessory."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a besoin de l'accès Bluetooth pour vérifier l'état des appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven זקוק לגישת Bluetooth כדי להציג את מצב הסוללה והחיבור של האביזרים האלחוטיים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven को आपके वायरलेस एक्सेसरीज़ के लिए बैटरी और कनेक्शन स्थिति प्रदर्शित करने के लिए ब्लूटूथ एक्सेस की आवश्यकता होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven treba pristup Bluetoothu za prikaz stanja baterije i veze vaših bežičnih dodataka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Notchhaven-nak Bluetooth-hozzáférésre van szüksége a vezeték nélküli kiegészítők akkumulátorának és csatlakozási állapotának megjelenítéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi memerlukan akses Bluetooth untuk memeriksa status perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app richiede l'accesso Bluetooth per verificare lo stato dei dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの状態を確認するためにBluetoothアクセスが必要です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven сымсыз аксессуарлардың батареясы мен қосылым күйін көрсету үшін Bluetooth рұқсатын қажет етеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 상태를 확인하려면 Bluetooth 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven memerlukan akses Bluetooth untuk memaparkan status bateri dan sambungan bagi aksesori wayarles anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven trenger Bluetooth-tilgang for å vise batteri- og tilkoblingsstatus for det trådløse tilbehøret ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app heeft Bluetooth-toegang nodig om de apparaatstatus te controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja wymaga dostępu do Bluetooth, aby sprawdzać stan urządzeń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação necessita de acesso Bluetooth para verificar o estado dos dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven are nevoie de acces Bluetooth pentru a afișa nivelul bateriei și starea conexiunii pentru accesoriile fără fir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению требуется доступ к Bluetooth для проверки состояния устройств."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven potrebuje prístup k Bluetooth na zobrazenie stavu batérie a pripojenia bezdrôtového príslušenstva."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven захтева Bluetooth приступ за приказ статуса батерије и везе ваших бежичних додатака."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen behöver Bluetooth-åtkomst för att kontrollera enhetsstatus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven จำเป็นต้องเข้าถึงบลูทูธเพื่อแสดงสถานะแบตเตอรี่และการเชื่อมต่อสำหรับอุปกรณ์เสริมไร้สายของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, aygıtların durumunu denetlemek için Bluetooth erişimine ihtiyaç duyuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програмі потрібен доступ до Bluetooth для перевірки стану пристроїв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng cần quyền truy cập Bluetooth để kiểm tra trạng thái thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用需要蓝牙访问权限，以检查设备状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式需要藍牙存取權限以檢查裝置狀態。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Notchhaven للوصول الكامل للتقويم لعرض أحداثك القادمة في الشق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven се нуждае от пълен достъп до календара, за да показва предстоящите ви събития в ноча."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven-এর নচে আপনার আসন্ন ইভেন্টগুলি প্রদর্শন করতে সম্পূর্ণ ক্যালেন্ডার অ্যাক্সেস প্রয়োজন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven necessita accés complet al calendari per mostrar els propers esdeveniments al notch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven potřebuje přístup ke Kalendáři pro zobrazení nadcházejících událostí ve výřezu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven har brug for fuld kalenderadgang for at vise dine kommende begivenheder i notchen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven benötigt Zugriff auf Ihren Kalender, um anstehende Ereignisse in der Notch anzuzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Notchhaven χρειάζεται πλήρη πρόσβαση στο ημερολόγιο για να εμφανίζει τα επερχόμενα συμβάντα σας στο notch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven needs access to your calendar to display upcoming events in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven necesita acceder a tu calendario para mostrar los próximos eventos en la muesca."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven برای نمایش رویدادهای آینده شما در ناچ به دسترسی کامل تقویم نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven tarvitsee täydet kalenterin käyttöoikeudet tulevien tapahtumien näyttämiseen notchissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng Notchhaven ng buong access sa kalendaryo upang ipakita ang iyong mga paparating na kaganapan sa notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven a besoin d'accéder à votre calendrier pour afficher les événements à venir dans l'encoche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven זקוק לגישה מלאה ללוח השנה כדי להציג את האירועים הקרובים שלך במגרעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच में आपके आगामी ईवेंट प्रदर्शित करने के लिए Notchhaven को पूर्ण कैलेंडर एक्सेस की आवश्यकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven treba potpuni pristup kalendaru za prikaz vaših nadolazećih događaja u urezu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Notchhaven-nak teljes naptár-hozzáférésre van szüksége a közelgő események notch-ban való megjelenítéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven memerlukan akses ke kalender untuk menampilkan acara mendatang di notch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven ha bisogno dell'accesso al calendario per mostrare i prossimi eventi nel notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチに予定を表示するためにカレンダーへのアクセスが必要です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven ойықта алдағы оқиғаларды көрсету үшін күнтізбеге толық кіру рұқсатын қажет етеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven가 예정된 이벤트를 노치에 표시하려면 캘린더 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven memerlukan akses kalendar penuh untuk memaparkan acara akan datang anda di notch."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven trenger full kalendertilgang for å vise dine kommende hendelser i notchen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven heeft toegang tot Agenda nodig om komende evenementen in de notch weer te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven wymaga dostępu do kalendarza, aby wyświetlać nadchodzące wydarzenia w notchu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Notchhaven precisa de acesso ao seu calendário para apresentar os próximos eventos no notch."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven are nevoie de acces complet la calendar pentru a afișa evenimentele viitoare în notch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven требуется доступ к календарю для отображения предстоящих событий в вырезе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven potrebuje úplný prístup ku kalendáru na zobrazenie nadchádzajúcich udalostí vo výreze."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven захтева пун приступ календару за приказ ваших предстојећих догађаја у ночу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven behöver åtkomst till Kalender för att visa kommande händelser i flärpen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven จำเป็นต้องเข้าถึงปฏิทินแบบเต็มเพื่อแสดงกิจกรรมที่จะเกิดขึ้นในรอยบาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven, yaklaşan etkinlikleri çentikte göstermek için takviminize erişmek istiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven потребує доступу до Календаря для відображення найближчих подій у вирізі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven cần quyền truy cập lịch để hiển thị các sự kiện sắp tới trên notch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven 需要访问你的日历，以便在刘海中显示即将到来的事件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven 需要行事曆存取權限以在「瀏海」中顯示即將發生的行程。"
          }
        }
      }
    },
