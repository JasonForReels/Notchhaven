          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven זקוק לגישה למצלמה כדי להציג תצוגה מקדימה ישירה של המצלמה במגרעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven को सीधे नॉच में कैमरा पूर्वावलोकन प्रदर्शित करने के लिए कैमरा एक्सेस की आवश्यकता होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven treba pristup kameri za prikaz pretpregleda kamere uživo izravno u urezu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Notchhaven-nak kamerahozzáférésre van szüksége az élő kamera-előnézet közvetlenül a notch-ban való megjelenítéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven memerlukan akses ke kamera untuk menampilkan pratinjau di notch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven ha bisogno dell'accesso alla fotocamera per mostrare l'anteprima nel notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチにプレビューを表示するためにカメラへのアクセスが必要です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven ойықта тікелей камераны алдын ала қарауды көрсету үшін камераға кіру рұқсатын қажет етеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven가 노치에 카메라 미리보기를 표시하려면 카메라 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven memerlukan akses kamera untuk memaparkan pratonton kamera langsung terus di notch."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven trenger kameratilgang for å vise en direkte kameraforhåndsvisning i notchen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven heeft cameratoegang nodig om een videovoorvertoning in de notch weer te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven wymaga dostępu do kamery, aby wyświetlać podgląd w notchu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Notchhaven precisa de acesso à câmara para mostrar a pré-visualização no notch."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven are nevoie de acces la cameră pentru a afișa o previzualizare a camerei direct în notch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven требуется доступ к камере для отображения превью камеры в вырезе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven potrebuje prístup ku kamere na zobrazenie živého náhľadu kamery priamo vo výreze."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven захтева приступ камери за приказ прегледа камере уживо директно у ночу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven behöver kameraåtkomst för att visa förhandsgranskning i flärpen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven จำเป็นต้องเข้าถึงกล้องเพื่อแสดงตัวอย่างกล้องในรอยบากโดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven, çentikte kamera önizlemesi göstermek için kameranıza erişmek istiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven потребує доступу до камери для попереднього перегляду у вирізі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven cần quyền truy cập camera để hiển thị bản xem trước trên notch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven 需要访问你的相机，以便在刘海中显示相机预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven 需要相機存取權限以在「瀏海」中顯示預覽畫面。"
          }
        }
      }
    },
