    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Notchhaven للوصول إلى الشبكة المحلية لاكتشاف أجهزة AirDrop القريبة لنقل الملفات عبر الشق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven се нуждае от достъп до локалната мрежа за откриване на близки AirDrop устройства за прехвърляне на файлове през ноча."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নচের মাধ্যমে ফাইল স্থানান্তরের জন্য আশেপাশের AirDrop ডিভাইসগুলি আবিষ্কার করতে Notchhaven-এর স্থানীয় নেটওয়ার্ক অ্যাক্সেস প্রয়োজন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven necessita accés a la xarxa local per descobrir dispositius AirDrop propers per a la transferència de fitxers mitjançant el notch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace potřebuje přístup k místní síti pro zjištění názvu aktuální sítě Wi-Fi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven har brug for adgang til det lokale netværk for at opdage AirDrop-enheder i nærheden til filoverførsel via notchen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App benötigt Zugriff auf das lokale Netzwerk, um den Namen Ihres aktuellen WLAN-Netzwerks zu ermitteln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Notchhaven χρειάζεται πρόσβαση στο τοπικό δίκτυο για την ανακάλυψη κοντινών συσκευών AirDrop για μεταφορά αρχείων μέσω του notch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app requires local network access to determine the name of your current Wi-Fi network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación necesita acceso a la red local para determinar el nombre de tu red Wi-Fi actual."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven برای کشف دستگاه‌های AirDrop مجاور جهت انتقال فایل از طریق ناچ به دسترسی به شبکه محلی نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven tarvitsee paikallisverkon käyttöoikeuden lähellä olevien AirDrop-laitteiden löytämiseen tiedostojen siirtoa varten notchin kautta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng Notchhaven ng access sa lokal na network upang matuklasan ang mga kalapit na AirDrop device para sa paglilipat ng file sa pamamagitan ng notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a besoin de l'accès au réseau local pour déterminer le nom de votre réseau Wi-Fi actuel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven זקוק לגישה לרשת המקומית כדי לגלות מכשירי AirDrop סמוכים להעברת קבצים דרך המגרעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच के माध्यम से फ़ाइल स्थानांतरण के लिए आस-पास के AirDrop उपकरणों को खोजने के लिए Notchhaven को स्थानीय नेटवर्क एक्सेस की आवश्यकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven treba pristup lokalnoj mreži za pronalaženje obližnjih AirDrop uređaja za prijenos datoteka putem ureza."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Notchhaven-nak helyi hálózati hozzáférésre van szüksége a közeli AirDrop eszközök felfedezéséhez a notch-on keresztüli fájlátvitelhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi memerlukan akses ke jaringan lokal untuk mengidentifikasi nama jaringan Wi-Fi saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app richiede l'accesso alla rete locale per identificare il nome della rete Wi-Fi attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のWi-Fiネットワーク名を特定するためにローカルネットワークへのアクセスが必要です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven ойық арқылы файлдарды тасымалдау үшін жақын маңдағы AirDrop құрылғыларын анықтау үшін жергілікті желіге кіру рұқсатын қажет етеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 Wi-Fi 네트워크 이름을 확인하려면 로컬 네트워크 접근 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven memerlukan akses rangkaian tempatan untuk menemui peranti AirDrop berdekatan bagi pemindahan fail melalui notch."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven trenger tilgang til lokalnettverket for å oppdage AirDrop-enheter i nærheten for filoverføring via notchen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app heeft toegang tot het lokale netwerk nodig om de huidige wifi-netwerknaam te bepalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja wymaga dostępu do sieci lokalnej, aby określić nazwę bieżącej sieci Wi-Fi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação necessita de acesso à rede local para identificar o nome da sua rede Wi-Fi atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven are nevoie de acces la rețeaua locală pentru a descoperi dispozitive AirDrop din apropiere pentru transferul de fișiere prin notch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению требуется доступ к локальной сети, чтобы определить название вашей текущей сети Wi-Fi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven potrebuje prístup k lokálnej sieti na vyhľadávanie okolitých zariadení AirDrop na prenos súborov cez výrez."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven захтева приступ локалној мрежи за откривање оближњих AirDrop уређаја за пренос датотека преко ноча."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen behöver åtkomst till det lokala nätverket för att identifiera aktuellt Wi-Fi-nätverksnamn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchhaven จำเป็นต้องเข้าถึงเครือข่ายท้องถิ่นเพื่อค้นหาอุปกรณ์ AirDrop ใกล้เคียงสำหรับการถ่ายโอนไฟล์ผ่านรอยบาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, geçerli Wi-Fi ağınızın adını belirlemek için yerel ağ erişimine ihtiyaç duyuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програмі потрібен доступ до локальної мережі для визначення поточної назви мережі Wi-Fi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng cần quyền truy cập mạng cục bộ để xác định tên mạng Wi-Fi hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用需要本地网络访问权限，以确定你当前 Wi-Fi 网络的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
